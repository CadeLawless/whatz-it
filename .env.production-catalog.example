# Copy to .env.local to let a development client follow production catalog
# publications. Commerce is intentionally disabled in this mode so sandbox
# transactions never enter the production entitlement database.
EXPO_PUBLIC_CATALOG_SOURCE=sqlite
EXPO_PUBLIC_CATALOG_SYNC=enabled
EXPO_PUBLIC_CATALOG_MANIFEST_URL=https://api.playwhatzit.com/api/v1/catalog/manifest
EXPO_PUBLIC_COMMERCE_API_BASE_URL=disabled
