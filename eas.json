{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "iap-development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CATALOG_SOURCE": "sqlite",
        "EXPO_PUBLIC_CATALOG_SYNC": "enabled",
        "EXPO_PUBLIC_CATALOG_MANIFEST_URL": "https://api-staging.playwhatzit.com/api/v1/catalog/manifest",
        "EXPO_PUBLIC_COMMERCE_API_BASE_URL": "https://api-staging.playwhatzit.com",
        "EXPO_PUBLIC_COMMERCE_TESTING": "enabled"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_CATALOG_SOURCE": "sqlite",
        "EXPO_PUBLIC_CATALOG_SYNC": "enabled",
        "EXPO_PUBLIC_CATALOG_MANIFEST_URL": "https://api-staging.playwhatzit.com/api/v1/catalog/manifest",
        "EXPO_PUBLIC_COMMERCE_API_BASE_URL": "https://api-staging.playwhatzit.com",
        "EXPO_PUBLIC_COMMERCE_TESTING": "enabled"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_CATALOG_SOURCE": "sqlite",
        "EXPO_PUBLIC_CATALOG_SYNC": "enabled",
        "EXPO_PUBLIC_CATALOG_MANIFEST_URL": "https://api-staging.playwhatzit.com/api/v1/catalog/manifest",
        "EXPO_PUBLIC_COMMERCE_API_BASE_URL": "https://api-staging.playwhatzit.com",
        "EXPO_PUBLIC_COMMERCE_TESTING": "enabled"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "WHATZIT_VERIFY_RELEASE_BASELINE": "enabled"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
