{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "iap-development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CATALOG_SOURCE": "sqlite",
        "EXPO_PUBLIC_CATALOG_MANIFEST_URL": "https://api-staging.playwhatzit.com/api/v1/catalog/manifest",
        "EXPO_PUBLIC_COMMERCE_API_BASE_URL": "https://api-staging.playwhatzit.com",
        "EXPO_PUBLIC_COMMERCE_TESTING": "enabled"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_CATALOG_SOURCE": "sqlite",
        "EXPO_PUBLIC_CATALOG_MANIFEST_URL": "https://api-staging.playwhatzit.com/api/v1/catalog/manifest",
        "EXPO_PUBLIC_COMMERCE_API_BASE_URL": "https://api-staging.playwhatzit.com",
        "EXPO_PUBLIC_COMMERCE_TESTING": "enabled"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
